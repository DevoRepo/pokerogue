VITE_BYPASS_LOGIN=1
VITE_BYPASS_TUTORIAL=1
VITE_SERVER_URL=http://localhost:8001
# IDs for discord/google auth go unused due to VITE_BYPASS_LOGIN
VITE_DISCORD_CLIENT_ID=1234567890
VITE_GOOGLE_CLIENT_ID=1234567890
VITE_I18N_DEBUG=0
VITE_PORT=8000
# Applies the benchmark overrides in src/overrides.ts and starts src/dev-tools/benchmark-driver.ts
VITE_BENCHMARK=1
# Includes src/dev-tools/perf-overlay.ts in this build; it is never bundled in a normal production build
VITE_PERF_TOOLS=1
